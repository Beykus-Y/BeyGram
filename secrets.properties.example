# Copy this file to secrets.properties and fill in your own Telegram API credentials.
telegramApiId=0
telegramApiHash=

# Optional Yandex Music configuration for both DEV and Stable. Leave both blank to disable the source.
yandexMusicClientId=
yandexMusicClientSecret=
# Signing key of the Yandex lyrics requests. Blank disables Yandex lyrics only.
yandexMusicLyricsSignKey=
