    <string name="account_security_delete_local_note_primary">BeyGram does not delete the local data of the main account: after the server account is deleted, it stays on the device. Other accounts are not affected.</string>
    <string name="account_security_delete_local_note_secondary">After server confirmation, BeyGram deletes only this account local session. Other accounts are not affected.</string>
