    <string name="loss_clear_local">Supprimer les fichiers de test locaux</string>
    <string name="loss_start_test">Démarrer le test</string>
    <string name="loss_send_confirm_title">Envoyer un message vidéo de test ?</string>
    <string name="loss_send_confirm_body">Un MP4 synthétique sans visage ni voix sera créé. BeyGram enverra le message vidéo dans vos messages enregistrés et en téléchargera une copie. Le message y restera jusqu’à ce que vous le supprimiez vous-même.</string>
    <string name="loss_send_confirm_button">Accepter et envoyer</string>
    <string name="loss_delete_confirm_title">Supprimer le test des messages enregistrés ?</string>
    <string name="loss_delete_confirm_body">Seul le message de test créé pendant cette vérification sera supprimé. Les autres messages ne sont pas affectés.</string>
