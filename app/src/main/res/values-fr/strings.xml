    <string name="loss_entry">Diagnostic de perte des messages vidéo — vérification des messages enregistrés</string>
    <string name="loss_dialog_title">Diagnostic de perte des messages vidéo</string>
    <string name="loss_dialog_description">BeyGram crée un échantillon de trois secondes sans accéder à votre caméra ni à votre microphone. Après confirmation distincte, il est envoyé vers les messages enregistrés puis téléchargé à nouveau. Cela consomme des données réseau. Le test ne mesure pas la cadence de la caméra.</string>
    <string name="loss_status">Statut : %1$s</string>
    <string name="loss_running_background">Le test continue si vous quittez cet écran. Fermer l’écran ne rappelle pas un message envoyé.</string>
