    <string name="settings_auto_download_title">Автозагрузка медиа</string>
    <string name="auto_download_intro">Выберите, что приложение может скачивать само в каждой сети. Ручная загрузка работает всегда.</string>
    <string name="auto_download_network_wifi">Wi-Fi</string>
