    <!-- Settings and feed -->
    <string name="trigger_title">Слова-триггеры</string>
    <string name="trigger_row_hint">Уведомления, когда в заглушённом чате пишут нужное слово</string>
    <string name="trigger_intro">Если слово или фраза из списка встречается в заглушённом чате, приходит отдельное уведомление, а совпадение попадает в ленту. Работает, пока приложение открыто или включена фоновая работа уведомлений.</string>
    <string name="trigger_scope_title">Где искать</string>
    <string name="trigger_scope_muted">Только в заглушённых чатах</string>
    <string name="trigger_scope_muted_hint">Telegram в них молчит, поэтому совпадение приходит уведомлением.</string>
    <string name="trigger_scope_all">Во всех чатах</string>
    <string name="trigger_scope_all_hint">В незаглушённых чатах совпадения идут только в ленту: Telegram и так уведомляет.</string>
    <string name="trigger_list_title">Слова</string>
    <string name="trigger_empty">Слов пока нет. Добавьте слово, фразу или регулярное выражение.</string>
    <string name="trigger_add">Добавить слово</string>
    <string name="trigger_feed_open">Лента упоминаний</string>
    <string name="trigger_feed_count">Записей: %1$d</string>

    <!-- Matching modes -->
    <string name="trigger_mode_title">Как искать</string>
    <string name="trigger_mode_whole">Целое слово</string>
    <string name="trigger_mode_whole_hint">Совпадает только целое слово. Для языков без пробелов (китайский, японский, тайский) выберите «Внутри текста».</string>
    <string name="trigger_mode_contains">Внутри текста</string>
    <string name="trigger_mode_contains_hint">Совпадает и внутри более длинных слов: «тест» найдёт «тесты».</string>
    <string name="trigger_mode_regex">Регулярное выражение</string>
    <string name="trigger_mode_regex_hint">Выражение RE2, например срочн\\p{L}*. Буквы других алфавитов пишите через \\p{L}: \\w и \\b работают только с латиницей и цифрами. Просмотр вперёд и обратные ссылки не поддерживаются. Регистр задаётся настройкой ниже.</string>

