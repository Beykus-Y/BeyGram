<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vpn-settings.xml" />
        <exclude domain="sharedpref" path="chat_message_drafts.xml" />
        <!-- The loopback SOCKS credentials are per installation; a restored copy would share them with another device. -->
        <exclude domain="sharedpref" path="mihomo-loopback.xml" />
        <!-- The diagnostics report draft is session-local; restoring it on another device makes no sense. -->
        <exclude domain="file" path="diagnostics-report" />
        <!-- Pending sends only: RAW video notes live in no_backup, restored queue files would be orphans. -->
        <exclude domain="file" path="uploads" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vpn-settings.xml" />
        <exclude domain="sharedpref" path="chat_message_drafts.xml" />
        <exclude domain="sharedpref" path="mihomo-loopback.xml" />
        <exclude domain="file" path="diagnostics-report" />
        <exclude domain="file" path="uploads" />
    </device-transfer>
</data-extraction-rules>
